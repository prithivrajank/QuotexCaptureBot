# Set a long random value locally and in Render. Never commit the real value.
INGEST_TOKEN=replace-with-a-long-random-secret
# Optional persistent PostgreSQL URL (Neon/Render PostgreSQL). Leave blank for local JSONL.
DATABASE_URL=
DATA_DIR=data
# Keep false until live Demo price/time calibration has been reviewed.
SIGNALS_ENABLED=false
CAPTURE_FPS=5

# Optional Telegram alerts. Leave both blank to disable notifications.
# Create a bot with Telegram's official BotFather, then set these privately in Render and local environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
